    "date-fns": "^4.4.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.12",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
